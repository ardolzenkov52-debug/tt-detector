# Скопируйте в .env и подставьте ключ.
# ВНИМАНИЕ: реальный ключ вставлять только в .env, этот файл попадает в git.

# ГигаЧат. «Авторизационные данные» из личного кабинета developers.sber.ru —
# длинная строка base64. Бесплатный доступ для физлиц.
GIGACHAT_CREDENTIALS=

# Бесплатный ключ, без карты: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Платный, по ТЗ §6: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательно. Провайдер выбирается по наличию ключа; можно задать явно:
# LLM_PROVIDER=gigachat            # gigachat | gemini | anthropic
# GIGACHAT_MODEL=GigaChat-2-Max    # или GigaChat-2-Pro, GigaChat-2
# GIGACHAT_SCOPE=GIGACHAT_API_PERS # для физлиц; B2B — GIGACHAT_API_B2B
# GIGACHAT_CA_BUNDLE=              # путь к сертификатам НУЦ Минцифры
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_MODEL=claude-opus-5
