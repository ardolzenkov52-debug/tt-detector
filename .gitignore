.env
.env.*
!.env.example
__pycache__/
*.pyc
node_modules/

# Результаты прогонов — кроме кеша публичного примера: он нужен на сервере,
# чтобы кнопка «Попробовать на примере» работала без обращений к модели.
# Именно `runs/*`, а не `runs/`: из исключённой папки git файл не возвращает.
runs/*
!runs/example.json

# Приватные материалы владельца проекта: в публичный репозиторий и в
# демонстрацию не попадают, служат только измерению полноты разбора.
data/concept_v2.md
data/concept_v3.md
data/reference_edits.json
/reference_edits.json
*.docx
